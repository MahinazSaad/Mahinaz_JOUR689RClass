library(tidyverse)
library(janitor)
library(lubridate)
library(tidyr)
SF <- rio::import("https://docs.google.com/spreadsheets/d/1-nkosLJKkfeLSl-UG82DDyiEw5-62kX2alS6ICG9iuk/edit#gid=552005485", sheet = "SF Police_Department_Calls_for_")
#This cleans column names
SF <- clean_names(SF)
#This processes dates for analysis, rearranges columns
SF <- SF |>
mutate(call_date2 = mdy(call_date),
year = year(call_date2)) |>
select(crime_id, original_crime_type_name, call_date2, year, call_date_time, disposition, address, city, state, everything())
#This processes dates for analysis, rearranges columns
SF <- SF |>
mutate(call_date2 = mdy(call_date),
year = year(call_date2)) |>
select(crime_id, original_crime_type_name, call_date2, year, call_date_time, disposition, address, city, state, everything())
#put the count total in an object called Action
Action <- SF |>
count(disposition) |>
arrange(n)
