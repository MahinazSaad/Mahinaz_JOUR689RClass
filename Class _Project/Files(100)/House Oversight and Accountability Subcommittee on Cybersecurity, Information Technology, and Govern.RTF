\ltrpar\li0\lin0\ri0\rin0\qj\faauto\sl260\slmult0\rtlch\afs24\ltrch\fs24{\rtlch\af2\alang1025\afs24\ltrch\b0\i0\fs20\lang1033\langnp1033\langfe1033\langfenp1033\loch\af2\dbch\af2\hich\f2\strike0\ulnone\cf2 n57 Id., at 3 ("All detectors trained with [Blended Image datasets] perform worst on darker faces from the African subgroup, especially male African faces (3.5 - 6.7% difference in error rate)").}
